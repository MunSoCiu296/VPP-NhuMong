# Copy file này thành .env để chạy local
# Trên Railway, set các biến này trong dashboard (Variables tab)

# PostgreSQL connection string
# - Local: đổi user/password/host/dbname cho đúng với Postgres local của bạn
# - Railway: copy DATABASE_URL từ PostgreSQL plugin (Internal URL)
DATABASE_URL="postgresql://user:password@localhost:5432/nhumong_dev"

# JWT secret - dùng chuỗi random dài cho production
# Tạo bằng: openssl rand -hex 32
JWT_SECRET="nhumong-dev-secret-change-in-production"

# Port (Railway tự set, không cần thêm thủ công)
PORT=3001

# Môi trường
NODE_ENV="development"
